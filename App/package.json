{
  "name": "app-de-gestion-de-riesgos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "electron": "electron .",
  "main": "electron.cjs",
  "build": {
    "appId": "com.riesgos.app",
    "productName": "App de gestion de riesgos",
    "files": [
      "build/**/*",
      "electron.cjs",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "forceCodeSigning": false
    },
    "extraResources": [
      {
        "from": "resources/api.exe",
        "to": "."
      }
    ]
  },
  "scripts": {
    "dev": "bun --hot src/index.tsx",
    "build": "bun build ./src/index.html --outdir=build --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "cross-env NODE_ENV=production bun src/index.tsx",
    "electron": "concurrently \"npm:dev\" \"electron .\"",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1",
    "react": "^19",
    "react-dom": "^19",
    "react-icons": "^5.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1"
  }
}
